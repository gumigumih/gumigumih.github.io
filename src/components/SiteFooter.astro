---
const year = new Date().getFullYear()
const links=[['X','https://twitter.com/gumigumih'],['Instagram','https://www.instagram.com/gumigumih'],['GitHub','https://github.com/gumigumih'],['note','https://note.com/gumigumih'],['Zenn','https://zenn.dev/gumigumih'],['Qiita','https://qiita.com/gumigumih']]
---
<footer class="bg-[#162235] text-white"><div class="mx-auto grid max-w-[1440px] gap-8 px-6 py-10 sm:px-10 lg:grid-cols-[1.2fr_1fr_1fr] lg:px-14"><div><img src="/assets/images/logo_black.svg" alt="meg+gumi" class="h-7 brightness-0 invert" /><p class="mt-4 text-xs leading-5 text-slate-300">必要なところに入り、Web開発を前へ。</p></div><nav class="grid grid-cols-2 gap-x-6 gap-y-3 text-xs font-bold text-slate-200"><a href="/#services">SERVICES</a><a href="/#profile">ABOUT</a><a href="/#works">WORKS</a><a href="/#work-style">WORK STYLE</a><a href="/#contact">CONTACT</a><a href="/about">ABOUT ME</a><a href="/privacy-policy">PRIVACY POLICY</a><a href="/terms">TERMS OF USE</a></nav><div class="lg:text-right"><p class="text-[10px] font-bold tracking-[.12em] text-slate-400">LINKS</p><div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-xs lg:justify-end">{links.map(([label,href])=><a href={href} target="_blank" rel="noopener noreferrer" class="text-slate-200 hover:text-pink-300">{label}</a>)}</div></div></div><div class="mx-auto flex max-w-[1440px] justify-between border-t border-slate-600 px-6 py-5 text-[10px] text-slate-400 sm:px-10 lg:px-14"><span>© {year} meg+gumi</span><span>WEB DEVELOPMENT PARTNER</span></div></footer>
<style>
footer{background:#1d2833}footer>div:first-child{padding-top:40px;padding-bottom:40px}footer nav,footer>div:first-child>div:last-child{border-left:1px solid #677382;padding-left:32px}footer a:hover{color:#f296c2}footer>div:last-child{margin-inline:auto}
@media(max-width:767px){footer nav,footer>div:first-child>div:last-child{padding-left:0;border:0}}
</style>
