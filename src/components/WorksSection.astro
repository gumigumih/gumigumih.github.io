---
import SectionHeading from './SectionHeading.astro'
const selectedProjects=[
{title:'EXIF Copy Tool',role:'Windows Tool',description:'写真のEXIF情報を右クリックからコピーできるWindowsツールです。',image:'/assets/images/exif-copy-tool/ogp.png',href:'/works/exif-copy-tool',period:'2026.06'},
{title:'わりまる / わけたべ',role:'Side Project',description:'飲み会や旅行の割り勘を軽くするWebアプリです。',image:'/assets/images/warimaru/ogp.png',href:'/works/warimaru',period:'2025.06'},
{title:'React電卓入力フォーム',role:'npm Package',description:'React用の電卓付き入力フォームを、npmパッケージとして公開しました。',image:'/assets/images/react-calculator-input-form/ogp.jpg',href:'/works/react-calculator-input-form',period:'2025.09'},
{title:'DHU ビジョンブック',role:'Frontend Development',description:'大学の中長期構想を伝える公式サイトのフロントエンド実装を担当しました。',image:'/assets/images/dhu-visionbook/ogp.png',href:'/works/dhu-visionbook',period:'2024.03'}]
---
<section id="works" class="design-section"><div class="section-inner">
<SectionHeading number="02" title="WORKS" description="これまでに制作・開発した主な実績です。" />
<div class="works-grid">{selectedProjects.map(item=><a href={item.href} class="work-card"><div class="work-image"><img src={item.image} alt={item.title} loading="lazy" width="600" height="400" /></div><h3>{item.title}<span aria-hidden="true">⟶</span></h3><p>{item.role}</p></a>)}</div>
</div></section>
<style>
.works-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:22px}.work-card{min-width:0}.work-image{aspect-ratio:1.02;background:#f2f4f6;overflow:hidden;display:flex;align-items:center}.work-image img{width:100%;height:100%;object-fit:contain;transition:transform .3s}.work-card:hover img{transform:scale(1.035)}.work-card h3{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:15px;font-weight:700;line-height:1.6;margin-top:13px}.work-card h3 span{font-size:24px;font-weight:400}.work-card p{font:11px Arial,sans-serif;color:#667181;margin-top:5px}
@media(max-width:767px){.works-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:25px 16px}.work-card h3{font-size:13px}}
</style>
