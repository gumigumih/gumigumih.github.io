---
const {number, title, description} = Astro.props
---
<div class="section-heading"><span class="section-number">{number}</span><div><h2>{title}</h2><p>{description}</p></div><slot /></div>
<style>
.section-heading{display:flex;align-items:start;gap:28px;margin-bottom:28px}.section-number{font:700 16px/2.6 Arial,sans-serif}.section-heading h2{font:800 clamp(28px,3.8vw,48px)/1.05 Arial,sans-serif;letter-spacing:-.035em}.section-heading p{font-size:14px;color:#667181;margin-top:9px}.section-heading :global(>p){margin-left:auto;max-width:430px;font-size:13px;line-height:1.8;align-self:center;color:#667181}
@media(max-width:767px){.section-heading{gap:16px;flex-wrap:wrap}.section-heading :global(>p){margin-left:32px}.section-number{font-size:12px}}
</style>
