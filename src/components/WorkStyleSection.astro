---
import SectionHeading from './SectionHeading.astro'
const items=[['01','進め方','機能・ページ・期間など、完了条件を決めて進めます。'],['02','連絡','リモート・チャット中心。必要に応じてオンラインで打ち合わせます。'],['03','稼働','平日夜・休日を中心に、合意した範囲と期日で対応します。'],['04','対応範囲','常時監視・オンコール・即時の緊急対応を伴う業務は対象外です。']]
---
<section id="work-style" class="design-section relative border-b border-[#bdc7d2] scroll-mt-[90px]"><div class="section-inner mx-auto max-w-[1440px] px-[3.7%] py-[46px] max-md:px-6 max-md:py-[34px] min-[1440px]:px-[54px]">
<SectionHeading number="04" title="WORK STYLE" description="スムーズで気持ちのよい制作・開発のために。" />
<div class="style-grid grid grid-cols-2 gap-x-4 gap-y-6 md:grid-cols-4 md:gap-7" data-reveal-group>{items.map(([number,title,description])=><article class="style-card border-l border-[#95a2b2] pl-[14px] md:pl-[22px]"><span class="style-number font-raleway text-[23px] font-bold">{number}</span><h3 class="style-title mt-2.5 text-lg font-extrabold md:text-xl">{title}</h3><p class="style-description mt-3 text-[13px] leading-[1.9] text-[#5b6675]">{description}</p></article>)}</div>
</div></section>
