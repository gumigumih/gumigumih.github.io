---
import SectionFrame from './SectionFrame.astro'

const conditions = [
  ['進め方', '機能・ページ・期間など、完了条件を決めて進行'],
  ['連絡', 'リモート・チャット中心。必要に応じてオンライン打ち合わせ'],
  ['稼働', '本業と調整しながら、平日夜・休日を中心に対応'],
  ['対象外', '常時監視、オンコール、即時の緊急対応を伴う業務'],
]
---

<SectionFrame
  id="work-style"
  eyebrow="work style"
  title="スポット対応だから、責任範囲を明確に"
  bgClass="bg-transparent"
  eyebrowClass="text-slate-500"
  titleClass="text-slate-900"
  leadClass="text-slate-600"
  lead="継続的に品質を保つため、完了条件を決めやすい案件を中心にお引き受けします。"
>
  <dl
    class="overflow-hidden rounded-[2rem] bg-white ring-1 ring-slate-200 shadow-lg shadow-slate-200/40"
    data-reveal-item
  >
    {conditions.map(([term, description], index) => (
      <div class:list={['grid gap-2 px-6 py-5 md:grid-cols-[140px_1fr] md:gap-6 md:px-8', index > 0 && 'border-t border-slate-100']}>
        <dt class="font-black text-slate-900">{term}</dt>
        <dd class="text-sm leading-relaxed text-slate-600 md:text-base">{description}</dd>
      </div>
    ))}
  </dl>
  <div
    class="mt-6 flex flex-wrap items-center justify-between gap-4 rounded-[2rem] bg-slate-900 px-5 py-4 ring-1 ring-slate-800 shadow-md shadow-slate-300/40 md:px-6"
    data-reveal-item
  >
    <p class="font-semibold text-white">依頼範囲がまだ曖昧でも、切り分けるところから相談できます。</p>
    <a href="#contact" class="inline-flex items-center gap-2 rounded-full bg-blue-100 px-5 py-3 text-sm font-semibold text-blue-950 transition hover:-translate-y-0.5 hover:bg-white hover:shadow-lg">
      相談内容を送る
      <span aria-hidden="true">→</span>
    </a>
  </div>
</SectionFrame>
