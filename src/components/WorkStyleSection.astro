---
import SectionHeading from './SectionHeading.astro'
const items=[['01','進め方','機能・ページ・期間など、完了条件を決めて進めます。'],['02','連絡','リモート・チャット中心。必要に応じてオンラインで打ち合わせます。'],['03','稼働','平日夜・休日を中心に、合意した範囲と期日で対応します。'],['04','対応範囲','常時監視・オンコール・即時の緊急対応を伴う業務は対象外です。']]
---
<section id="work-style" class="design-section"><div class="section-inner">
<SectionHeading number="04" title="WORK STYLE" description="スムーズで気持ちのよい制作・開発のために。" />
<div class="style-grid">{items.map(([number,title,description])=><article><span>{number}</span><h3>{title}</h3><p>{description}</p></article>)}</div>
</div></section>
<style>
.style-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:28px}.style-grid article{border-left:1px solid #95a2b2;padding-left:22px}.style-grid span{font:700 23px Arial,sans-serif}.style-grid h3{font-weight:800;font-size:20px;margin-top:10px}.style-grid p{color:#5b6675;font-size:13px;line-height:1.9;margin-top:12px}
@media(max-width:767px){.style-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:24px 16px}.style-grid article{padding-left:14px}.style-grid h3{font-size:18px}}
</style>
