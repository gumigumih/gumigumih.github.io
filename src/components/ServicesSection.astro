---
import SectionHeading from './SectionHeading.astro'
const services = [
{title:'フロントエンド実装',description:'デザインの意図を形に。画面幅や利用環境に合わせ、保守しやすい実装を行います。',type:'frontend'},
{title:'バックエンド開発',description:'API開発やデータ連携、既存機能の改善まで。サービスの仕組みを支えます。',type:'backend-sql'},
{title:'Web制作・開発支援',description:'要件整理から実装・公開まで。プロジェクトに必要な範囲で参加します。',type:'planning'}
]
---
<section id="services" class="design-section"><div class="section-inner">
<SectionHeading number="01" title="SERVICES" description="必要なスキルを、必要なタイミングで。"><p>フロントエンドからバックエンドまで。<br />Web制作・開発に関わる業務を柔軟にサポートします。</p></SectionHeading>
<div class="service-grid">{services.map(service=><article><div class="service-visual"><img src={`/assets/images/service-${service.type}.jpg`} alt="" width="600" height="270" loading="lazy" /></div><h3>{service.title}</h3><p>{service.description}</p></article>)}</div>
<p class="service-audience">制作会社・広告代理店のスポット開発から、個人事業のWeb制作まで対応します。</p>
</div></section>
<style>
.service-visual img{filter:saturate(.18) contrast(1.08) brightness(.88);object-position:center 48%}
.service-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:28px}.service-grid article{position:relative;min-width:0}.service-grid article+article:before{content:"";position:absolute;left:-14px;top:0;bottom:0;border-left:1px solid #bdc7d2}.service-visual{aspect-ratio:2.2;overflow:hidden;background:#17212c}.service-visual img{width:100%;height:100%;object-fit:cover}.service-grid h3{font-weight:800;font-size:clamp(17px,1.7vw,23px);margin:20px 0 10px;letter-spacing:-.04em}.service-grid p{font-size:14px;line-height:1.9;color:#536070}.service-audience{font-size:12px;color:#667181;margin-top:24px}
@media(max-width:767px){.service-grid{grid-template-columns:1fr;gap:28px}.service-grid article+article:before{display:none}.service-visual{aspect-ratio:2.6}.service-grid h3{margin-top:15px;font-size:20px}}
</style>
