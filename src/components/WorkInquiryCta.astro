---
export interface Props {
  lead?: string
}

const {
  lead = '同様のWeb制作・開発や、既存サイトの改善をご相談いただけます。',
} = Astro.props as Props
---

<aside class="mt-8 border-y border-slate-300 bg-white px-6 py-8 text-slate-900 md:px-8 md:py-10">
  <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
    <div class="max-w-2xl">
      <p class="text-xs uppercase tracking-[0.25em] text-pink-600">work inquiry</p>
      <h2 class="mt-3 text-2xl font-black md:text-3xl">Web制作・開発について相談する</h2>
      <p class="mt-3 text-sm leading-relaxed text-slate-600 md:text-base">
        {lead} 担当範囲が決まっていない段階でも、切り分けるところから対応します。
      </p>
    </div>
    <a
      href="/#contact"
      class="inline-flex shrink-0 items-center justify-center gap-2 bg-pink-600 px-5 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:"
    >
      相談内容を送る
      <span aria-hidden="true">→</span>
    </a>
  </div>
</aside>
