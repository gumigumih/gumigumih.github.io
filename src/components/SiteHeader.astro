---
import activeSectionNavSrc from '../scripts/activeSectionNav.ts?url'
export interface Props { baseUrl?: string }
const { baseUrl = '' } = Astro.props as Props
const navLinks = [['HOME','/'],['SERVICES','/#services'],['WORKS','/#works'],['ABOUT','/#profile'],['WORK STYLE','/#work-style'],['CONTACT','/#contact']]
---
<header class="site-header sticky top-0 z-50 border-b border-[#bdc7d2] bg-white" data-component="site-header"><div class="header-inner mx-auto flex min-h-[76px] max-w-[1440px] items-stretch pl-[5.3%] max-md:min-h-16 max-md:px-6 max-md:pl-6 min-[1440px]:pl-[76px]">
<a href={`${baseUrl}/`} class="header-logo flex w-[41.5%] items-center gap-[18px] border-r border-[#bdc7d2] px-[22px] py-[14px] max-md:w-auto max-md:border-0 max-md:px-0 max-md:py-3" aria-label="meg+gumi ホーム"><img class="header-logo-image w-40 max-md:w-[135px]" src="/assets/images/logo_black.svg" width="145" height="31" alt="meg+gumi" /><span class="header-logo-tagline font-raleway text-[9px] font-semibold leading-[1.4] tracking-[.04em] text-[#647183] max-[420px]:hidden">WEB DEVELOPMENT<br />PARTNER</span></a>
<nav class="desktop-nav flex flex-1 items-center justify-evenly gap-4 px-5 max-md:hidden" aria-label="メインナビゲーション">{navLinks.map(([label,href])=><a class="desktop-nav-link focus-ring relative whitespace-nowrap py-2.5 font-raleway text-[11px] font-bold tracking-[.05em] hover:text-[#c82978]" data-section-nav href={`${baseUrl}${href}`} aria-current={href==='/' && Astro.url.pathname==='/'?'page':undefined}>{label}</a>)}</nav>
<button id="mobile-menu-toggle" class="hidden items-center gap-3 font-raleway text-[11px] font-bold max-md:flex" aria-controls="mobile-menu" aria-expanded="false" aria-label="メニューを開く">MENU <span class="menu-mark text-[22px] text-[#e83f93]" aria-hidden="true">＋</span></button>
</div><nav id="mobile-menu" class="mobile-menu grid grid-cols-2 gap-x-6 border-t border-[#bdc7d2] p-4" aria-label="モバイルナビゲーション" hidden>{navLinks.map(([label,href])=><a class="mobile-nav-link block border-b border-[#d5dce3] p-4 font-raleway text-xs font-bold hover:text-[#c82978] aria-[current=page]:text-[#c82978]" data-section-nav href={`${baseUrl}${href}`}>{label}</a>)}</nav></header>
<script type="module" src={activeSectionNavSrc}></script>
<script>
const toggle=document.getElementById('mobile-menu-toggle')
const menu=document.getElementById('mobile-menu')
function closeMenu(){if(menu) menu.hidden=true;toggle?.setAttribute('aria-expanded','false');toggle?.setAttribute('aria-label','メニューを開く')}
toggle?.addEventListener('click',()=>{if(!menu)return;menu.hidden=!menu.hidden;toggle.setAttribute('aria-expanded',String(!menu.hidden));toggle.setAttribute('aria-label',menu.hidden?'メニューを開く':'メニューを閉じる')})
menu?.querySelectorAll('a').forEach(link=>link.addEventListener('click',closeMenu))
document.addEventListener('keydown',event=>{if(event.key==='Escape'&&menu&&!menu.hidden){closeMenu();toggle?.focus()}})
</script>
<style>
.desktop-nav-link[aria-current=page]:after{content:"";position:absolute;bottom:2px;left:0;right:0;height:3px;background:#e83f93}
</style>
