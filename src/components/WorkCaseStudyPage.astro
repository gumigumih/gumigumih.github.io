---
import SiteHead from './SiteHead.astro'
import SiteHeader from './SiteHeader.astro'
import SiteFooter from './SiteFooter.astro'
import SubpageStyles from './SubpageStyles.astro'
import WorkInquiryCta from './WorkInquiryCta.astro'

interface LinkItem {
  label: string
  href: string
  icon: string
  primary?: boolean
  external?: boolean
}

interface ImplementationItem {
  title: string
  description: string
}

interface DetailImage {
  src: string
  alt: string
  caption: string
  width?: number
  height?: number
}

export interface Props {
  title: string
  metaTitle: string
  description: string
  image: string
  imageAlt: string
  canonicalPath: string
  tags: string
  date: string
  subtitle: string
  detailImages?: DetailImage[]
  overview: string[]
  challenge: string
  scope: string[]
  implementation: ImplementationItem[]
  outcome: string[]
  links: LinkItem[]
  inquiryLead: string
}

const props = Astro.props as Props
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <SiteHead
    title={props.metaTitle}
    description={props.description}
    image={`https://meggumi.com${props.image}`}
    canonicalPath={props.canonicalPath}
  />
</head>
<body class="subpage bg-white font-sans text-[#162235]">
  <SubpageStyles />
  <SiteHeader />
  <main class="page-main relative z-10 pb-16 pt-24">
    <div class="mx-auto max-w-6xl px-4">
      <nav class="breadcrumb py-7 text-xs text-[#687486]" aria-label="パンくずリスト">
        <ol class="flex items-center gap-2 text-sm text-slate-500">
          <li><a href="/" class="page-link breadcrumb-link border-b border-[#c4ccd6] pb-[3px] hover:text-slate-700">ホーム</a></li>
          <li aria-hidden="true"><i class="fas fa-chevron-right"></i></li>
          <li><a href="/#works" class="page-link breadcrumb-link border-b border-[#c4ccd6] pb-[3px] hover:text-slate-700">実績</a></li>
          <li aria-hidden="true"><i class="fas fa-chevron-right"></i></li>
          <li class="text-slate-800">{props.title}</li>
        </ol>
      </nav>

      <header class="case-hero overflow-hidden border-y border-[#bdc7d2] bg-white">
        <div class="grid lg:grid-cols-[minmax(320px,0.9fr)_minmax(0,1.1fr)]">
          <div class="case-hero-media flex aspect-[16/9] items-center border-r border-[#bdc7d2] bg-[#f2f4f6] py-6 md:py-10 lg:aspect-auto max-md:border-b max-md:border-r-0">
            <img src={props.image} alt={props.imageAlt} class="case-hero-image h-full w-full object-contain" />
          </div>
          <div class="flex flex-col justify-center p-6 md:p-8 lg:p-10">
            <p class="text-xs uppercase tracking-[0.24em] text-slate-500">case study</p>
            <h1 class="page-title mt-3 text-[clamp(28px,3.8vw,52px)] font-black leading-[1.45] tracking-[-.045em] text-slate-900">{props.title}</h1>
            <div class="mt-4 flex flex-wrap items-center justify-between gap-3 text-sm text-slate-500">
              <span>{props.tags}</span>
              <time datetime={props.date}>{props.date.replace('-', '.')}</time>
            </div>
            <p class="mt-6 text-lg leading-relaxed text-slate-600 md:text-xl">{props.subtitle}</p>
          </div>
        </div>
      </header>
    </div>

    <div class="case-body mx-auto max-w-[1152px] px-6">
      {props.detailImages && props.detailImages.length > 0 && (
        <section class="case-gallery border-b border-[#bdc7d2] py-10 md:py-14" aria-labelledby="case-gallery-title">
          <div class="max-w-2xl">
            <p class="font-raleway text-xs font-bold uppercase tracking-[0.24em] text-[#c82e7c]">visuals</p>
            <h2 id="case-gallery-title" class="mt-3 text-2xl font-black tracking-[-.03em] text-slate-900 md:text-3xl">画面・ビジュアル</h2>
            <p class="mt-4 text-sm leading-[1.9] text-slate-600">実際の画面や制作物の一部を紹介します。</p>
          </div>
          <div class="mt-8 grid gap-6 md:grid-cols-2">
            {props.detailImages.map((detailImage) => (
              <figure class="overflow-hidden border border-[#bdc7d2] bg-[#f2f4f6]">
                <div class="flex justify-center overflow-hidden bg-white">
                  <img
                    src={detailImage.src}
                    alt={detailImage.alt}
                    class="h-auto w-full object-contain"
                    width={detailImage.width}
                    height={detailImage.height}
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <figcaption class="border-t border-[#bdc7d2] px-4 py-3 text-xs font-semibold tracking-[0.04em] text-slate-700">
                  {detailImage.caption}
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}

      <section class="case-section relative m-0 border-b border-[#bdc7d2] bg-white py-[38px] pl-[30%] max-md:py-[30px] max-md:pl-0">
        <p class="case-section-label absolute left-0 top-10 font-raleway text-xs font-bold uppercase tracking-[0.24em] text-[#c82e7c] max-md:static">01 / overview</p>
        <h2 class="page-section-title case-section-title absolute left-0 top-[61px] m-0 text-2xl font-black text-slate-900 md:text-3xl max-md:static max-md:mb-5 max-md:mt-2">概要</h2>
        <div class="case-section-content !mt-0 space-y-4 leading-relaxed text-slate-600">
          {props.overview.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </section>

      <section class="case-section relative m-0 border-b border-[#bdc7d2] bg-white py-[38px] pl-[30%] max-md:py-[30px] max-md:pl-0">
        <p class="case-section-label absolute left-0 top-10 font-raleway text-xs font-bold uppercase tracking-[0.24em] text-[#c82e7c] max-md:static">02 / challenge</p>
        <h2 class="page-section-title case-section-title absolute left-0 top-[61px] m-0 text-2xl font-black text-slate-900 md:text-3xl max-md:static max-md:mb-5 max-md:mt-2">課題</h2>
        <p class="case-section-content !mt-0 leading-relaxed text-slate-600">{props.challenge}</p>
      </section>

      <section class="case-section relative m-0 border-b border-[#bdc7d2] bg-white py-[38px] pl-[30%] max-md:py-[30px] max-md:pl-0">
        <p class="case-section-label absolute left-0 top-10 font-raleway text-xs font-bold uppercase tracking-[0.24em] text-[#c82e7c] max-md:static">03 / scope</p>
        <h2 class="page-section-title case-section-title absolute left-0 top-[61px] m-0 text-2xl font-black text-slate-900 md:text-3xl max-md:static max-md:mb-5 max-md:mt-2">担当範囲</h2>
        <ul class="case-section-content !mt-0 grid gap-3 md:grid-cols-2">
          {props.scope.map((item) => (
            <li class="scope-item flex items-start gap-3 bg-slate-50 px-4 py-3 text-sm leading-relaxed text-slate-700 md:text-base">
              <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-pink-500"></span>
              {item}
            </li>
          ))}
        </ul>
      </section>

      <section class="case-section relative m-0 border-b border-[#bdc7d2] bg-white py-[38px] pl-[30%] max-md:py-[30px] max-md:pl-0">
        <p class="case-section-label absolute left-0 top-10 font-raleway text-xs font-bold uppercase tracking-[0.24em] text-[#c82e7c] max-md:static">04 / implementation</p>
        <h2 class="page-section-title case-section-title absolute left-0 top-[61px] m-0 text-2xl font-black text-slate-900 md:text-3xl max-md:static max-md:mb-5 max-md:mt-2">実装・工夫</h2>
        <div class="case-section-content !mt-0 grid gap-4 md:grid-cols-3">
          {props.implementation.map((item) => (
            <article class="implementation-card bg-slate-50 p-5 ">
              <h3 class="font-black text-slate-900">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">{item.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="case-section relative m-0 border-b border-[#bdc7d2] bg-white py-[38px] pl-[30%] max-md:py-[30px] max-md:pl-0">
        <p class="case-section-label absolute left-0 top-10 font-raleway text-xs font-bold uppercase tracking-[0.24em] text-[#c82e7c] max-md:static">05 / outcome</p>
        <h2 class="page-section-title case-section-title absolute left-0 top-[61px] m-0 text-2xl font-black text-slate-900 md:text-3xl max-md:static max-md:mb-5 max-md:mt-2">成果</h2>
        <div class="case-section-content !mt-0 space-y-4 leading-relaxed text-slate-600">
          {props.outcome.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="case-links mt-7 flex flex-wrap gap-3 border-t border-[#bdc7d2] pt-6">
          {props.links.map((link) => (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class:list={[
                'page-link inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold transition-colors',
                link.primary
                  ? 'bg-pink-600 text-white hover:bg-pink-700'
                  : 'border border-slate-300 text-slate-700 hover:bg-slate-50',
              ]}
            >
              <i class={link.icon} aria-hidden="true"></i>
              {link.label}
            </a>
          ))}
        </div>
      </section>

      <WorkInquiryCta lead={props.inquiryLead} />

      <div class="mt-10 text-center">
        <a href="/#works" class="page-link back-link mt-10 inline-flex items-center bg-slate-100 px-6 py-3 text-slate-700 transition-colors hover:bg-slate-200">
          <i class="fas fa-arrow-left mr-2"></i>
          実績一覧に戻る
        </a>
      </div>
    </div>
  </main>
  <SiteFooter />
</body>
</html>
