---
import '../styles/tailwind.css'
import SiteHead from '../components/SiteHead.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import SubpageStyles from '../components/SubpageStyles.astro'
import WorkInquiryCta from '../components/WorkInquiryCta.astro'
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <SiteHead
    title="ABOUT ME | meg+gumi"
    description="Web制作・開発をスポットで支援するmeg+gumiの経験領域と、仕事で大切にしていることを紹介します。"
    canonicalPath="/about"
  />
</head>
<body class="subpage">
  <SubpageStyles />
  <SiteHeader />
  <main class="pt-24">
    <section class="relative z-10 py-20 px-4 md:px-8">
      <div class="page-intro mx-auto max-w-6xl">
        <h1 class="page-label">ABOUT ME</h1>
        <p class="mt-8 text-base md:text-lg max-w-4xl text-slate-600 leading-relaxed">
          meg+gumi は、制作会社、広告代理店、個人事業主のWeb制作・開発をスポットで支援する、ぐみのポートフォリオです。
          フロントエンド実装からAPI・バックエンド開発まで、必要な範囲を横断して対応します。
        </p>
      </div>

      <div class="mt-8 md:mt-10 mx-auto max-w-5xl">
        <div class="document-content">
          <div class="space-y-10 text-slate-600 leading-relaxed">
            <section class="space-y-4">
              <h2 class="text-xl md:text-2xl font-black text-slate-900">運営者</h2>
              <p>
                ぐみ（gumigumih）が運営しています。Web開発とプロジェクト推進の経験を活かし、
                要件整理、設計、実装、品質確認、運用までを見渡しながら仕事を進めています。
              </p>
            </section>

            <section class="space-y-4">
              <h2 class="text-xl md:text-2xl font-black text-slate-900">対応している領域</h2>
              <p>
                デザインデータからのフロントエンド実装、小規模なAPIや外部サービス連携、既存サイト・サービスの改修、
                Web制作に必要な技術要件の整理などに対応しています。
              </p>
            </section>

            <section class="space-y-4">
              <h2 class="text-xl md:text-2xl font-black text-slate-900">仕事で大切にしていること</h2>
              <p>
                依頼された実装だけを見るのではなく、その目的や公開後の運用までを確認します。
                担当範囲と完了条件を明確にし、制作と開発の間にある曖昧さを整理しながら進めることを大切にしています。
              </p>
            </section>
          </div>
        </div>
        <WorkInquiryCta lead="制作会社・広告代理店のスポット開発や、個人事業のWeb制作をご相談いただけます。" />
      </div>
    </section>
  </main>
  <div class="mx-auto max-w-5xl px-6 pb-10"><a class="back-link" href="/">← ホームに戻る</a></div>
  <SiteFooter />
</body>
</html>
