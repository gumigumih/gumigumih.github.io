---
import '../styles/tailwind.css'
import SiteHead from '../components/SiteHead.astro'
import SiteHeader from '../components/SiteHeader.astro'
import HeroSection from '../components/HeroSection.astro'
import ServicesSection from '../components/ServicesSection.astro'
import IntroSection from '../components/IntroSection.astro'
import WorksSection from '../components/WorksSection.astro'
import WorkStyleSection from '../components/WorkStyleSection.astro'
import ContactSection from '../components/ContactSection.astro'
import SiteFooter from '../components/SiteFooter.astro'
import revealOnScrollSrc from '../scripts/revealOnScroll.ts?url'
import scrollMotionSrc from '../scripts/scrollMotion.ts?url'
import textMotionSrc from '../scripts/textMotion.ts?url'
---
<!DOCTYPE html><html lang="ja"><head><SiteHead title="meg+gumi | スポット対応のWeb開発パートナー" description="制作会社、広告代理店、個人事業主に向けて、フロントエンド実装、バックエンド開発、既存サイトの改修をスポットで支援します。" canonicalPath="/" /></head>
<body id="app" class="homepage bg-white font-sans text-[#111c29]"><SiteHeader /><main><HeroSection /><ServicesSection /><WorksSection /><IntroSection /><WorkStyleSection /><ContactSection /></main><SiteFooter /><script type="module" src={revealOnScrollSrc}></script><script type="module" src={scrollMotionSrc}></script><script type="module" src={textMotionSrc}></script></body></html>
<style is:global>
.reveal-ready [data-reveal],.reveal-ready [data-reveal-item]{opacity:0;transform:translateY(24px);filter:blur(4px);transition:opacity .46s ease,transform .7s cubic-bezier(.2,.72,.18,1),filter .58s ease;transition-delay:var(--reveal-delay,0ms)}
.reveal-ready .is-revealed{opacity:1;transform:translateY(0);filter:blur(0)}
.reveal-ready .service-card,.reveal-ready .work-card{transition-delay:var(--reveal-delay,0ms)}
.reveal-ready .service-card .service-visual,.reveal-ready .work-card .work-image{position:relative}
.reveal-ready .service-card .service-visual::after,.reveal-ready .work-card .work-image::after{content:"";position:absolute;inset:0;background:#e83f93;transform-origin:bottom;transform:scaleY(1);transition:transform .7s cubic-bezier(.7,0,.2,1);transition-delay:var(--reveal-delay,0ms);pointer-events:none}
.reveal-ready .service-card.is-revealed .service-visual::after,.reveal-ready .work-card.is-revealed .work-image::after{transform:scaleY(0)}
.typewriter-char{display:inline-block;opacity:0;transform:translateY(.2em);transition:opacity .08s linear,transform .12s ease}.typewriter-char.is-typed{opacity:1;transform:translateY(0)}.hero-title.is-typing::after{content:"|";display:inline-block;margin-left:.08em;color:#e83f93;animation:typewriter-cursor .7s steps(1) infinite}.hero-title.is-typed-complete::after{animation:none;opacity:0;transition:opacity .2s ease}@keyframes typewriter-cursor{50%{opacity:0}}
@media (prefers-reduced-motion:reduce){.reveal-ready [data-reveal],.reveal-ready [data-reveal-item]{opacity:1;transform:none;filter:none;transition:none}.reveal-ready .service-card .service-visual::after,.reveal-ready .work-card .work-image::after{display:none}}
</style>
<style is:global>
.homepage .design-section::before{content:"";position:absolute;top:-1px;left:0;width:min(19vw,260px);height:3px;background:#e83f93;transform:scaleX(var(--section-progress,0));transform-origin:left;pointer-events:none}
.homepage .focus-ring:focus-visible{outline:2px solid #bd206c;outline-offset:5px}
@media(prefers-reduced-motion:reduce){.homepage .design-section::before{transform:scaleX(1)}}
</style>
