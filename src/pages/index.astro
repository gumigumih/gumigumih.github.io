---
import '../styles/tailwind.css'
import SiteHead from '../components/SiteHead.astro'
import SiteHeader from '../components/SiteHeader.astro'
import HeroSection from '../components/HeroSection.astro'
import ServicesSection from '../components/ServicesSection.astro'
import IntroSection from '../components/IntroSection.astro'
import WorksSection from '../components/WorksSection.astro'
import WorkStyleSection from '../components/WorkStyleSection.astro'
import ContactSection from '../components/ContactSection.astro'
import SiteFooter from '../components/SiteFooter.astro'
import revealOnScrollSrc from '../scripts/revealOnScroll.ts?url'
---
<!DOCTYPE html><html lang="ja"><head><SiteHead title="meg+gumi | スポット対応のWeb開発パートナー" description="制作会社、広告代理店、個人事業主に向けて、フロントエンド実装、バックエンド開発、既存サイトの改修をスポットで支援します。" canonicalPath="/" /></head>
<body id="app" class:list={["homepage"]}><SiteHeader /><main><HeroSection /><ServicesSection /><WorksSection /><IntroSection /><WorkStyleSection /><ContactSection /></main><SiteFooter /><script type="module" src={revealOnScrollSrc}></script></body></html>
<style is:global>.reveal-ready [data-reveal],.reveal-ready [data-reveal-item]{opacity:0;transform:translateY(18px);transition:opacity .42s ease,transform .52s ease}.reveal-ready .is-revealed{opacity:1;transform:translateY(0)}@media (prefers-reduced-motion:reduce){.reveal-ready [data-reveal],.reveal-ready [data-reveal-item]{opacity:1;transform:none;transition:none}}</style>
<style is:global>
.homepage{background:#fff;color:#111c29}
.homepage .design-section{border-bottom:1px solid #bdc7d2;scroll-margin-top:90px}
.homepage .section-inner{max-width:1440px;margin:auto;padding:46px 3.7%}
.homepage .design-button{display:inline-flex;align-items:center;justify-content:center;gap:22px;border:1px solid #687589;min-height:54px;font-size:14px;font-weight:700;transition:background .2s}
.homepage .design-button.primary{background:#e83f93;border-color:#e83f93;color:#fff}
.homepage .design-button:hover{background:#f3f5f7}
.homepage .design-button.primary:hover{background:#cc2879}
.homepage a:focus-visible,.homepage button:focus-visible{outline:2px solid #bd206c;outline-offset:5px}
.homepage #contact-form{display:grid;gap:18px}
.homepage #contact-form>div.space-y-2{display:grid;grid-template-columns:145px minmax(0,1fr);gap:18px;margin:0;align-items:start}
.homepage #contact-form label{font-size:12px;padding-top:12px}
.homepage #contact-form input,.homepage #contact-form textarea{margin:0;font-size:13px;padding:10px 12px}
.homepage #contact-form textarea{min-height:120px;height:120px}
.homepage #contact-form .text-center{padding:0;margin-left:163px}
.homepage #submit-button{width:100%;justify-content:center;background:#e83f93}
.homepage #contact-form .flex.justify-center{margin-left:163px}
@media(min-width:1440px){.homepage .section-inner{padding-inline:54px}}
@media(max-width:767px){.homepage .section-inner{padding:34px 24px}.homepage #contact>.section-inner>.w-full>div{border:0;padding:0}.homepage #contact-form>div.space-y-2{grid-template-columns:1fr;gap:5px}.homepage #contact-form .text-center,.homepage #contact-form .flex.justify-center{margin-left:0}.homepage #contact-form label{padding:0}}
</style>
