---
import '../../styles/tailwind.css'
import SiteHead from '../../components/SiteHead.astro'
import SiteHeader from '../../components/SiteHeader.astro'
import SiteFooter from '../../components/SiteFooter.astro'
import SubpageStyles from '../../components/SubpageStyles.astro'
import articlesData from '../../../public/articles.json' assert { type: 'json' }

export function getStaticPaths() {
  const articles = (articlesData as any)?.data?.contents ?? []
  return articles.map((article: any) => ({
    params: { key: article.key },
    props: { article },
  }))
}

const { article } = Astro.props as { article: any }
const img = article.localImagePath || article.eyecatch || '/assets/images/ogp.png'
const tags = (article.hashtags || []) as any[]
const toc = (article.toc || []) as Array<{ level: number; text: string }>
const paragraphs = String(article.body || article.description || '')
  .split(/\n+/)
  .map((text) => text.trim())
  .filter(Boolean)

const formatDate = (s: string) => {
  const d = new Date(s)
  const yyyy = d.getFullYear()
  const mm = String(d.getMonth() + 1).padStart(2, '0')
  const dd = String(d.getDate()).padStart(2, '0')
  return `${yyyy}.${mm}.${dd}`
}

const getExternalUrl = (a: any) => {
  switch (a.type) {
    case 'qiita': return `https://qiita.com/gumigumih/items/${a.key}`
    case 'zenn': return `https://zenn.dev/gumigumih/articles/${a.key}`
    case 'note':
    default: return `https://note.com/gumigumih/n/${a.key}`
  }
}
---
<!DOCTYPE html>
<html lang="ja">
<head>
  <SiteHead
    title={`${article.name} | meg+gumi`}
    description={article.description || `${article.name} の概要と本文抜粋です。`}
    image={`https://meggumi.com${img}`}
    canonicalPath={`/articles/${article.key}`}
    robots="noindex, nofollow"
  />
</head>
<body class="subpage bg-white font-sans text-[#162235]">
  <SubpageStyles />
  <SiteHeader />
  <main class="page-main pb-16 pt-24 max-md:pb-10">
    <article class="article-page relative z-10 px-4 py-16 md:px-8">
      <div class="mx-auto max-w-4xl">
        <nav class="breadcrumb flex flex-wrap items-center gap-2 py-7 text-xs text-[#687486]" aria-label="パンくずリスト"><a class="page-link breadcrumb-link border-b border-[#c4ccd6] pb-[3px]" href="/">HOME</a><span>/</span>
          <a
            href="https://note.com/gumigumih"
            target="_blank"
            rel="noopener noreferrer"
            class="page-link breadcrumb-link hover:text-slate-700"
          >note</a>
          <span>/</span>
          <span class="text-slate-700">{article.name}</span>
        </nav>

        <div class="flex items-center gap-3">
          <span class="h-0.5 w-10 bg-slate-400"></span>
          <span class="uppercase tracking-[0.25em] text-xs text-slate-500">{article.type || 'article'}</span>
        </div>
        <h1 class="page-title mt-4 text-[clamp(28px,3.8vw,52px)] font-black leading-[1.45] tracking-[-.045em] text-slate-900">{article.name}</h1>
        <div class="mt-5 flex flex-wrap items-center gap-3 text-sm text-slate-500">
          <time datetime={article.publishAt}>{formatDate(article.publishAt)}</time>
          {tags.slice(0, 6).map((t) => (
            <span class="inline-flex items-center gap-1 border border-slate-200 bg-white px-3 py-1 text-xs text-slate-600">
              <i class="fa-solid fa-tag text-[10px] opacity-60" aria-hidden="true"></i>
              {t.hashtag?.name}
            </span>
          ))}
        </div>

        <div class="article-cover mt-8 overflow-hidden border-y border-[#bdc7d2] bg-white">
          <img class="article-cover-image aspect-[1200/630] w-full object-contain" src={img} alt={article.name} loading="eager" decoding="async" />
        </div>

        <div class="article-copy mt-10 border-t border-[#bdc7d2] py-9">
          {toc.length > 0 && (
            <section class="article-toc mb-8 border-l-2 border-pink-500 bg-white px-5 py-5 md:px-6">
              <p class="text-xs uppercase tracking-[0.24em] text-slate-500">table of contents</p>
              <h2 class="page-section-title mt-2 text-lg font-black text-slate-900 md:text-xl">元記事の目次</h2>
              <p class="mt-2 text-sm text-slate-500">
                このページでは概要を掲載しています。全文はnoteで読めます。
              </p>
              <ol class="mt-4 space-y-2 text-sm md:text-base text-slate-700">
                {toc.map((heading) => (
                  <li class={heading.level === 3 ? 'pl-5 text-slate-500' : 'font-semibold text-slate-800'}>
                    <span class="mr-2 text-slate-400">/</span>
                    {heading.text}
                  </li>
                ))}
              </ol>
            </section>
          )}
          <div class="relative max-h-[30rem] overflow-hidden">
            <div class="space-y-5 text-base md:text-lg leading-relaxed text-slate-700">
              {paragraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))}
            </div>
            <div class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-white/0 via-white/80 to-white"></div>
          </div>
          <div class="mt-6 border-t border-slate-200 pt-6">
            <p class="mb-4 text-sm text-slate-500">
              ここでは概要を掲載しています。続きは元の記事で読めます。
            </p>
            <a
              class="page-link"
              href={getExternalUrl(article)}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 bg-pink-600 px-5 py-3 text-sm font-semibold text-white transition hover:-translate-y-0.5"
            >
              元の記事を読む
              <i class="fa-solid fa-arrow-up-right-from-square text-xs" aria-hidden="true"></i>
            </a>
          </div>
        </div>
      </div>
    </article>
  </main>
  <SiteFooter />
</body>
</html>
